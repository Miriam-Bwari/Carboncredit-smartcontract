<?xml version="1.0" encoding="utf-8"?>
<!-- Satellite globe icon for ShambaGuard splash screen -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- Globe circle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,8 C18.745,8 8,18.745 8,32 C8,45.255 18.745,56 32,56 C45.255,56 56,45.255 56,32 C56,18.745 45.255,8 32,8 Z" />

    <!-- Globe latitude lines (green to show detail) -->
    <path
        android:fillColor="#1B6B2E"
        android:pathData="M32,8 C26,8 21,18.745 21,32 C21,45.255 26,56 32,56 C38,56 43,45.255 43,32 C43,18.745 38,8 32,8 Z" />

    <!-- Horizontal latitude lines -->
    <path
        android:strokeColor="#1B6B2E"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M10,24 Q32,20 54,24" />
    <path
        android:strokeColor="#1B6B2E"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M8.5,32 Q32,28 55.5,32" />
    <path
        android:strokeColor="#1B6B2E"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M10,40 Q32,44 54,40" />

    <!-- Vertical meridian line -->
    <path
        android:strokeColor="#1B6B2E"
        android:strokeWidth="1.5"
        android:pathData="M32,8 L32,56" />

    <!-- Globe outer ring (outline) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0"
        android:fillColor="#00000000"
        android:pathData="M32,8 C18.745,8 8,18.745 8,32 C8,45.255 18.745,56 32,56 C45.255,56 56,45.255 56,32 C56,18.745 45.255,8 32,8 Z" />

    <!-- Satellite dish / signal arc (top right) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M44,14 Q52,14 52,22" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M44,18 Q48,18 48,22" />

    <!-- Satellite dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,22 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />

</vector>
